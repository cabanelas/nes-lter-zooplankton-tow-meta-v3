.Rhistory
.RData
.Rproj.user/

# --- data/: ignore by default, then whitelist specific paths ---
data/*
!data/raw/
!data/processed/

# data/raw: ignore its contents, then re-include specific files + bongo_logs
data/raw/*
!data/raw/bongo_logs/
!data/raw/max_depth_tdr_corrected.csv
!data/raw/nes-lter-zooplankton-tow-metadata-v2.csv
!data/raw/nes-lter-bongo-tdr-offsets.csv
!data/raw/elog_zoop_tows_thruHRS2601_2026-08-10.csv
!data/raw/shipspeed_eventlog_v2.csv

# inside bongo_logs: track everything EXCEPT inventory_v2
data/raw/bongo_logs/inventory_v2/

# data/processed: track only .csv and .rds (not the v2/ folder)
data/processed/*
!data/processed/README.md